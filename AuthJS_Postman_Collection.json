{
  "info": {
    "_postman_id": "authjs-render-production-collection",
    "name": "AuthJS - API Render Production",
    "description": "Colección completa de endpoints para AuthJS desplegado en Render (https://authjs.onrender.com). Incluye auto-guardado automático del JWT token en la variable {{jwt_token}} tras registro o login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://authjs.onrender.com",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check (Estado y DB)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Comprueba el estado de salud del contenedor en Render y la conexión a MongoDB Atlas."
      },
      "response": []
    },
    {
      "name": "2. Registro de Usuario (POST /new)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.token) {",
              "    pm.collectionVariables.set('jwt_token', res.token);",
              "    console.log('JWT Token guardado automáticamente en {{jwt_token}}');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Eduardo Cruz\",\n  \"email\": \"eduardo_postman@midominio.com\",\n  \"password\": \"miPasswordSeguro123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/new",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "new"]
        },
        "description": "Crea un nuevo usuario en la base de datos y guarda el token resultante en la colección."
      },
      "response": []
    },
    {
      "name": "3. Login de Usuario (POST /)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.token) {",
              "    pm.collectionVariables.set('jwt_token', res.token);",
              "    console.log('JWT Token guardado automáticamente en {{jwt_token}}');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"eduardo_postman@midominio.com\",\n  \"password\": \"miPasswordSeguro123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/auth",
          "host": ["{{base_url}}"],
          "path": ["api", "auth"]
        },
        "description": "Inicia sesión con credenciales válidas y actualiza la variable {{jwt_token}}."
      },
      "response": []
    },
    {
      "name": "4. Renovar Token (GET /renew - Header x-token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.token) {",
              "    pm.collectionVariables.set('jwt_token', res.token);",
              "    console.log('Nuevo JWT Token renovado y guardado en {{jwt_token}}');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-token",
            "value": "{{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/renew",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "renew"]
        },
        "description": "Ruta protegida. Utiliza automáticamente el header x-token guardado de la petición anterior."
      },
      "response": []
    },
    {
      "name": "5. Web Estática (GET /)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"],
          "path": [""]
        },
        "description": "Sirve la página pública estática index.html."
      },
      "response": []
    }
  ]
}
